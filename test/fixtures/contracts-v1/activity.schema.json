{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:birdify:activity:1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "mapId", "mapRevision", "sessionId", "taskId", "sequence", "phase", "scope", "targets", "reason", "files", "unmappedFiles", "evidenceKind", "checks"],
  "properties": {
    "constraintReviews": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["constraintId", "plan", "status", "method", "evidence", "checkIndexes"],
      "properties": {
        "constraintId": { "$ref": "urn:birdify:architecture:1#/$defs/id" },
        "checkedAt": { "type": "string", "format": "date-time" },
        "gitCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
        "plan": { "$ref": "urn:birdify:architecture:1#/$defs/text" },
        "status": { "enum": ["unverified", "supported", "violated"] },
        "method": { "enum": ["test", "review"] },
        "evidence": { "type": "string", "maxLength": 2000 },
        "checkIndexes": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
        "translations": { "type": "object", "additionalProperties": {
          "type": "object", "additionalProperties": false, "required": ["plan", "evidence"],
          "properties": { "plan": { "type": "string", "minLength": 1 }, "evidence": { "type": "string" } }
        } }
      }
    } },
    "collaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "locks"],
      "properties": {
        "agent": { "type": "string", "minLength": 1 },
        "locks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,40}$" },
    "projectId": { "$ref": "urn:birdify:architecture:1#/$defs/id" },
    "mapId": { "$ref": "urn:birdify:architecture:1#/$defs/id" },
    "mapRevision": { "type": "integer", "minimum": 1 },
    "sessionId": { "$ref": "urn:birdify:architecture:1#/$defs/id" },
    "taskId": { "$ref": "urn:birdify:architecture:1#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "phase": { "enum": ["planned", "editing", "verifying", "completed", "failed", "cancelled"] },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:birdify:architecture:1#/$defs/id" } },
    "targets": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:birdify:architecture:1#/$defs/id" } },
    "reason": { "$ref": "urn:birdify:architecture:1#/$defs/text" },
    "translations": { "type": "object", "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["reason"],
      "properties": { "reason": { "$ref": "urn:birdify:architecture:1#/$defs/text" } }
    } },
    "files": { "$ref": "#/$defs/paths" }, "unmappedFiles": { "$ref": "#/$defs/paths" },
    "evidenceKind": { "const": "agent-declared" },
    "checks": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["command", "status", "exitCode", "summary"],
      "properties": {
        "command": { "$ref": "urn:birdify:architecture:1#/$defs/text" },
        "status": { "enum": ["passed", "failed", "not-run"] },
        "translations": { "type": "object", "additionalProperties": {
          "type": "object", "additionalProperties": false, "required": ["summary"],
          "properties": { "summary": { "$ref": "urn:birdify:architecture:1#/$defs/text" } }
        } },
        "exitCode": { "type": ["integer", "null"] }, "summary": { "$ref": "urn:birdify:architecture:1#/$defs/text" }
      }
    } }
  },
  "$defs": { "paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:birdify:architecture:1#/$defs/path" } } }
}
