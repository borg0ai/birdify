{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:birdify:architecture:1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "mapId", "revision", "project", "modules", "relationships"],
  "properties": {
    "constraintDiscovery": {
      "type": "object", "additionalProperties": false,
      "required": ["checkedAt", "checkedPaths", "uninspectedPaths"],
      "properties": {
        "checkedAt": { "type": "string", "format": "date-time" },
        "checkedPaths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "uninspectedPaths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
      }
    },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
    "schemaVersion": { "const": 1 },
    "language": { "$ref": "#/$defs/language" },
    "groups": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "members", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" },
        "role": { "enum": ["interaction", "runtime", "external-services", "generic"] },
        "members": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "evidence": { "type": "array", "$ref": "#/$defs/evidenceList", "minItems": 1 },
        "translations": { "$ref": "#/$defs/translations" }
      }
    } },
    "mapId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "project": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "translations": { "$ref": "#/$defs/translations" }, "revision": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" } }
    },
    "modules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "kind", "responsibility", "ownership", "evidence", "status", "openQuestions", "layout"],
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" },
          "translations": { "$ref": "#/$defs/translations" },
          "kind": { "enum": ["local", "external"] }, "responsibility": { "$ref": "#/$defs/text" },
          "role": { "enum": ["frontend", "backend", "cache", "database", "queue", "security", "generic"] },
          "roleAssessment": {
            "type": "object", "additionalProperties": false, "required": ["basis", "note"],
            "properties": {
              "basis": { "enum": ["out-of-taxonomy", "insufficient-evidence"] },
              "note": { "$ref": "#/$defs/text" },
              "translations": { "$ref": "#/$defs/translations" }
            }
          },
          "ownership": { "type": "array", "uniqueItems": true, "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "path"],
            "properties": { "kind": { "enum": ["file", "directory"] }, "path": { "$ref": "#/$defs/path" } }
          } },
          "evidence": { "$ref": "#/$defs/evidenceList" }, "status": { "enum": ["supported", "uncertain"] },
          "openQuestions": { "$ref": "#/$defs/questions" },
          "layout": { "type": "object", "additionalProperties": false, "required": ["row", "column"],
            "properties": { "row": { "type": "integer", "minimum": 0 }, "column": { "type": "integer", "minimum": 0 } } }
        }
      }
    },
    "relationships": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "label", "kind", "visibility", "evidence", "status", "openQuestions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" },
        "translations": { "$ref": "#/$defs/translations" },
        "label": { "$ref": "#/$defs/text" }, "evidence": { "$ref": "#/$defs/evidenceList" },
        "kind": { "enum": ["request", "result", "dependency", "event", "control"] },
        "visibility": { "enum": ["overview", "detail"] },
        "status": { "enum": ["supported", "uncertain"] }, "openQuestions": { "$ref": "#/$defs/questions" }
      }
    } }
  },
  "$defs": {
    "constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "note", "origin", "strength", "applicability", "scope", "modules", "relationships", "evidence", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" }, "note": { "$ref": "#/$defs/text" },
        "explanation": { "$ref": "#/$defs/text" },
        "code": { "$ref": "#/$defs/evidenceList" },
        "baselineCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
        "origin": { "enum": ["local", "user", "inferred"] },
        "strength": { "enum": ["required", "preferred"] },
        "applicability": { "enum": ["applicable", "superseded", "not-applicable", "uncertain", "conflict"] },
        "scope": { "enum": ["project", "modules", "relationships", "task"] },
        "taskId": { "$ref": "#/$defs/id" },
        "modules": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "relationships": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "supersededBy": { "$ref": "#/$defs/id" },
        "conflictsWith": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "evidence": { "$ref": "#/$defs/evidenceList" },
        "verification": { "$ref": "#/$defs/text" },
        "translations": { "$ref": "#/$defs/translations" }
      }
    },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "maxLength": 35 },
    "translations": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "patternProperties": { "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$": { "$ref": "#/$defs/translation" } }
    },
    "translation": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "name": { "$ref": "#/$defs/text" }, "responsibility": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" }, "note": { "$ref": "#/$defs/text" },
        "explanation": { "$ref": "#/$defs/text" },
        "verification": { "$ref": "#/$defs/text" },
        "openQuestions": { "$ref": "#/$defs/questions" }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
    "path": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.\\.?|\\.git)(?:/|$))(?!.*//)(?!.*[\\\\:\\u0000-\\u001f\\u007f])[^/].*[^/]$|^[^./\\\\:\\u0000-\\u001f\\u007f]$" },
    "questions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "evidenceList": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "note"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "note": { "$ref": "#/$defs/text" }, "quote": { "$ref": "#/$defs/text" }, "translations": { "$ref": "#/$defs/translations" }, "symbol": { "$ref": "#/$defs/text" }, "line": { "type": "integer", "minimum": 1 }, "endLine": { "type": "integer", "minimum": 1 } },
      "dependentRequired": { "endLine": ["line"] }
    } }
  }
}
