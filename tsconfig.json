{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "newLine": "lf",
    "rootDir": "src",
    "outDir": "birdify/scripts",
    "types": ["node"]
  },
  "include": ["src/**/*.mts"],
  "exclude": [
    "src/viewer/**",
    "src/site/**",
    "src/build-tests.mts",
    "src/build-viewer.mts",
    "src/bundle-runtime.mts",
    "src/check-build.mts",
    "src/check-docs.mts",
    "src/check-install.mts",
    "src/contracts/export.mts"
  ]
}
